# Server-only unless prefixed NEXT_PUBLIC_. Never commit real values.
# Mura Core is the single AI authority; the frontend never holds provider keys.
#
# MURA_CORE_API_KEY is deliberately absent. Core stopped accepting that
# credential for family data in PR-03B, and this app has no service-internal
# consumer, so it must not hold a credential that authorizes one. User requests
# carry the signed-in user's own bearer, attached server-side by the proxy.
MURA_API_URL=https://your-mura-core.example.com

# ------------------------------------------------- local development issuer
# Optional, local only. Setting MURA_DEV_AUTH=true starts an RS256 issuer inside
# `next dev` that mints real tokens Core verifies through the normal OIDC path:
# signature checked against the JWKS at /api/dev-auth/jwks.json, with iss, aud,
# exp, nbf and sub all verified. Membership is still read from PostgreSQL on
# every request, so no authorization behaviour changes -- only who issues the
# token. Its gate requires MURA_DEV_AUTH=true *and* a non-production build *and*
# no Vercel deployment, so a deployment cannot acquire an issuer by accident.
#
# Both values must equal Core's AUTH_ISSUER and AUTH_AUDIENCE exactly, or every
# request is rejected -- which is the intended failure, not a bug.
# MURA_DEV_AUTH=true
# DEV_AUTH_ISSUER=http://127.0.0.1:3000/api/dev-auth
# DEV_AUTH_AUDIENCE=mura-core

# --------------------------------------------------------------- Clerk (auth)
# Clerk establishes identity only. Families, roles and every authorization
# decision stay in MURA's PostgreSQL, so none of them belong in a token claim.
#
# The publishable key is intentionally public and ships in the browser bundle.
# The secret key is server-only: never give it a NEXT_PUBLIC_ prefix.
# Leave both unset until you have real Clerk Dashboard keys. Example
# placeholders (pk_test_replace-me) make Clerk throw "Publishable key not valid".
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Name of the JWT template created in the Clerk Dashboard. Core validates `aud`
# and a Clerk session token carries no audience claim, so the token forwarded to
# Core is minted from a template whose `aud` equals Core's AUTH_AUDIENCE.
# Defaults to "mura-core" when unset.
CLERK_JWT_TEMPLATE=mura-core

# Where Clerk sends users. Keep aligned with the app's route names.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------- Sentry (Error Tracking)
# Optional. Setting NEXT_PUBLIC_SENTRY_DSN enables client and server error tracking.
# If omitted, Sentry is cleanly disabled.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

