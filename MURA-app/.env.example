# Server-only unless prefixed NEXT_PUBLIC_. Never commit real values.
# Mura Core is the single AI authority; the frontend never holds provider keys.
#
# MURA_CORE_API_KEY is deliberately absent. Core stopped accepting that
# credential for family data in PR-03B, and this app has no service-internal
# consumer, so it must not hold a credential that authorizes one. User requests
# carry the signed-in user's own bearer, attached server-side by the proxy.
MURA_API_URL=https://your-mura-core.example.com

# --------------------------------------------------------------- Clerk (auth)
# Clerk establishes identity only. Families, roles and every authorization
# decision stay in MURA's PostgreSQL, so none of them belong in a token claim.
#
# The publishable key is intentionally public and ships in the browser bundle.
# The secret key is server-only: never give it a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Name of the JWT template created in the Clerk Dashboard. Core validates `aud`
# and a Clerk session token carries no audience claim, so the token forwarded to
# Core is minted from a template whose `aud` equals Core's AUTH_AUDIENCE.
# Defaults to "mura-core" when unset.
CLERK_JWT_TEMPLATE=mura-core

# Where Clerk sends users. Keep aligned with the app's route names.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
