# ==============================================================================
# MURA (Мұра) — Environment Configuration Template
# Copy to `.env` for local docker compose or configure directly in hosting platform.
# Never commit actual production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=mura
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=mura
# Database connection string used by API, Worker, and Migrations
DATABASE_URL=postgresql+psycopg://mura:replace_with_secure_postgres_password@postgres:5432/mura

# ------------------------------------------------------------------------------
# 2. Mura Core API Settings
# ------------------------------------------------------------------------------
# Environment: local | test | staging | production
MURA_ENVIRONMENT=local

# Security Tokens (Each must have at least 32 characters and be distinct):
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORE_API_KEY=replace_with_at_least_32_random_characters_for_core_api_key
WORKER_REGISTRATION_TOKEN=replace_with_at_least_32_characters_for_worker_registration
OPERATIONS_API_KEY=replace_with_at_least_32_characters_for_operations_api_key
KAGGLE_ASR_API_KEY=replace_with_at_least_32_characters_for_kaggle_asr_token

# CORS Allowed Origins (Comma-separated scheme://host[:port] without trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Host header allowlist. In production set this to the public API host(s).
ALLOWED_HOSTS=
# Uvicorn trusts X-Forwarded-* only from these proxy IPs/CIDRs.
# Keep the loopback default unless your deployment has a known trusted ingress range.
FORWARDED_ALLOW_IPS=127.0.0.1

# Authentication (OIDC / Clerk)
# In production/staging, AUTH_MODE must be 'oidc'. In local/test, 'disabled' is permitted.
AUTH_MODE=disabled
AUTH_ISSUER=
AUTH_AUDIENCE=mura-core
AUTH_JWKS_URL=
AUTH_ALLOWED_ALGORITHMS=RS256

# ------------------------------------------------------------------------------
# 3. Worker & AI Providers (DeepSeek & Whisper)
# ------------------------------------------------------------------------------
# DeepSeek API (Used by Worker for structured claims & entity extraction)
DEEPSEEK_API_KEY=sk-replace-with-real-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

# ASR Transcription: whisper | kaggle
ASR_PROVIDER=whisper
WHISPER_API_KEY=replace_with_real_whisper_or_openai_api_key
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WORKER_QUEUES=recording,book,cleanup

# ------------------------------------------------------------------------------
# 4. Frontend (Next.js 15)
# ------------------------------------------------------------------------------
# Server-side proxy target (Inside Docker Compose: http://api:8000; Vercel: Railway URL)
MURA_API_URL=http://api:8000

# Clerk Authentication (Public key reaches browser; Secret key stays on server)
MURA_AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_TEMPLATE=mura-core
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 5. Object Storage Configuration (Audio & Family Books)
# ------------------------------------------------------------------------------
# Backend: 'local' (development / Docker Compose) or 'supabase' (production)
AUDIO_STORAGE_BACKEND=local
BOOK_STORAGE_BACKEND=local

# When the corresponding storage backend is 'local':
AUDIO_STORAGE_DIR=/app/data/audio
BOOK_STORAGE_DIR=/app/data/books
CORE_MAX_UPLOAD_MB=25

# When either storage backend is 'supabase' (Production API & Worker):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# SUPABASE_STORAGE_BUCKET=mura-audio
# SUPABASE_BOOKS_BUCKET=mura-books
# SUPABASE_STORAGE_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 6. Durable Worker Queue Settings
# ------------------------------------------------------------------------------
BOOK_JOB_LEASE_SECONDS=600
BOOK_JOB_HEARTBEAT_SECONDS=60
BOOK_JOB_POLL_INTERVAL_SECONDS=2.0
BOOK_RETRY_BASE_SECONDS=5
BOOK_RETRY_MAX_SECONDS=300

# Physical object erasure is asynchronous and durable. API DELETE transactions
# persist storage_cleanup_jobs; the worker removes objects with leases/retries.
STORAGE_CLEANUP_LEASE_SECONDS=120
STORAGE_CLEANUP_HEARTBEAT_SECONDS=30
STORAGE_CLEANUP_POLL_INTERVAL_SECONDS=2
STORAGE_CLEANUP_MAX_ATTEMPTS=8
STORAGE_CLEANUP_RETRY_BASE_SECONDS=5
STORAGE_CLEANUP_RETRY_MAX_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. Observability, Logging & Sentry Error Tracking (Optional)
# ------------------------------------------------------------------------------
# Structured JSON logging for Railway Log Explorer: 'auto' (json in prod), 'json', 'text'
LOG_FORMAT=auto
LOG_LEVEL=INFO

# Backend Core & Worker Sentry (Railway)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Frontend Next.js Sentry (Vercel)
# NEXT_PUBLIC_SENTRY_DSN=



