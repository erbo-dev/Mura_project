# Environment: local | test | staging | production
# staging and production fail closed on unsafe configuration.
MURA_ENVIRONMENT=local

# Core API
DEEPSEEK_API_KEY=sk-replace-with-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro

# Generate independent values with at least 32 random characters:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CORE_API_KEY=replace-with-at-least-32-random-characters
WORKER_REGISTRATION_TOKEN=replace-with-another-32-character-token
KAGGLE_ASR_API_KEY=replace-with-a-third-32-character-token
# Destructive operator routes (/v1/operations/*) only. Must differ from
# CORE_API_KEY so a leaked application token cannot activate a release.
OPERATIONS_API_KEY=replace-with-a-fourth-32-character-token

# PostgreSQL. Required in staging and production; SQLite is rejected there.
DATABASE_URL=postgresql+psycopg://mura:mura@localhost:5432/mura
# Local/test convenience only. Must stay false in staging and production, where
# schema changes are applied with Alembic.
DATABASE_AUTO_CREATE=false

# Connection pool per process. Conservative defaults for one managed instance.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_SECONDS=30

# Comma-separated browser origins, scheme://host[:port] with no trailing slash.
# Required in staging and production, where "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional Host header allowlist. Leave empty to disable the check.
ALLOWED_HOSTS=
# Leave unset to expose /docs, /redoc and /openapi.json only in local and test.
EXPOSE_API_DOCS=

# --------------------------------------------------------------- identity
# Standards-based OIDC. Core verifies RS256 signatures against the configured
# JWKS endpoint and checks iss, aud, exp, nbf and sub. Nothing here is provider
# specific: Clerk is the chosen provider, but Core has no Clerk SDK and no
# knowledge of one.
#
# 'disabled' is local/test only and is rejected in staging and production, where
# a real provider is required and there is no service-token fallback.
AUTH_MODE=oidc
# Clerk's issuer for the instance. Development and production instances differ,
# so this is deployment configuration, never a hardcoded domain.
#   development: https://<subdomain>.clerk.accounts.dev
#   production:  https://clerk.<your-domain>
AUTH_ISSUER=https://replace-with-your-clerk-issuer
# The audience Core requires. A Clerk session token carries no `aud` claim, so
# the frontend mints the forwarded token from a Clerk JWT template whose `aud`
# is exactly this value. Both sides must agree or every request is rejected.
AUTH_AUDIENCE=mura-core
# Trusted configuration, never derived from a token: a forged `iss` must not be
# able to choose where signing keys are fetched from.
AUTH_JWKS_URL=https://replace-with-your-clerk-issuer/.well-known/jwks.json
# RS256 only. Symmetric algorithms are deliberately excluded: mixing them with
# public-key verification is how key-confusion attacks happen.
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_JWKS_CACHE_SECONDS=300

# Only 'local' is implemented. Staging and production require an absolute path.
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_DIR=.mura/audio
CORE_MAX_UPLOAD_MB=25
JOB_POLL_INTERVAL_SECONDS=1
ASR_RETRY_SECONDS=15
ASR_REQUEST_TIMEOUT_SECONDS=900

# Kaggle ASR worker
HF_TOKEN=hf_optional_for_public_model
ASR_DEVICE=cuda:0
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=900
CORE_BACKEND_URL=
